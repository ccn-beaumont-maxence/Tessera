// Builds Dawnvale once: abbey, village, vineyard, mine, roads, forest, mountains, camps, people.
using "./common.tess";
using "./models.tess";

const float VALLEY = 82;   // mountains ring radius

// Open ground kept free of trees: abbey, road, meadow, vineyard, mine, village.
bool open(vec3 p) {
    if (dist(p, vec3(0, 0, -6)) < 24) return false;
    if (abs(p.x) < 5 && p.z > 0 && p.z < 70) return false;
    if (dist(p, vec3(-34, 0, -4)) < 13) return false;
    if (dist(p, vec3(34, 0, 6)) < 15) return false;
    if (dist(p, vec3(30, 0, -48)) < 15) return false;
    if (dist(p, vec3(0, 0, 66)) < 17) return false;
    return true;
}

vec3 anywhere(float maxR) {
    float a = random(0, PI * 2);
    float r = sqrt(random(0, maxR * maxR));
    return vec3(cos(a) * r, 0, sin(a) * r);
}

// A flat dirt strip from a to b.
void road(vec3 a, vec3 b) {
    vec3 d = b - a;
    spawn("Part", Transform3D { position = (a + b) * 0.5 + vec3(0, 0.02, 0), rotation = euler(0, atan2(d.x, d.z), 0) },
        Mesh { shape = "box", size = vec3(3, 0.04, len(d) + 3), color = color("#a08660") });
}

void fence(vec3 a, vec3 b) {
    vec3 d = b - a;
    int n = floor(len(d) / 2);
    for (int i = 0; i <= n; i++)
        spawn("Part", Transform3D { position = a + d * (i * 1.0 / n) + vec3(0, 0.5, 0) }, Mesh { shape = "box", size = vec3(0.15, 1, 0.15), color = color("#7a5a3a") });
    spawn("Part", Transform3D { position = (a + b) * 0.5 + vec3(0, 0.75, 0), rotation = euler(0, atan2(d.x, d.z), 0) },
        Mesh { shape = "box", size = vec3(0.08, 0.1, len(d)), color = color("#8a6a45") });
}

void abbey() {
    color stone = color("#c9bfa8");
    color slate = color("#3d5a99");
    house(vec3(0, 0, -14), 12, 20, 7, PI, stone, slate);
    house(vec3(-9.5, 0, -10), 7, 10, 5, PI, stone, slate);
    house(vec3(9.5, 0, -10), 7, 10, 5, PI, stone, slate);
    tower(vec3(-6.5, 0, -3), 1.8, 11, stone, slate);
    tower(vec3(6.5, 0, -3), 1.8, 11, stone, slate);
    // Courtyard: flagstones, a fountain, banners.
    spawn("Part", Transform3D { position = vec3(0, 0.03, 4) }, Mesh { shape = "box", size = vec3(14, 0.06, 12), color = color("#b3aa95") });
    Entity f = spawn("Part", Transform3D { position = vec3(0, 0.3, 5) }, Mesh { shape = "cylinder", size = vec3(3.6, 0.6, 3.6), color = stone }, Collider { size = vec3(3, 0.6, 3) });
    Entity water = part(f, "cylinder", vec3(0, 0.25, 0), vec3(3.1, 0.1, 3.1), color("#5fb8e8"));
    get<Mesh>(water).emissive = 0.3;
    part(f, "cylinder", vec3(0, 0.8, 0), vec3(0.4, 1.6, 0.4), stone);
    for (int i = -1; i <= 1; i += 2) {
        spawn("Part", Transform3D { position = vec3(i * 4, 2, 2.5) }, Mesh { shape = "cylinder", size = vec3(0.12, 4, 0.12), color = color("#5a3f2a") });
        spawn("Part", Transform3D { position = vec3(i * 4, 2.9, 2.75) }, Mesh { shape = "box", size = vec3(0.9, 1.6, 0.05), color = color("#2d4f9e") });
        spawn("Part", Transform3D { position = vec3(i * 4, 3, 2.79) }, Mesh { shape = "box", size = vec3(0.4, 0.4, 0.03), color = color("#e3c04f") });
    }
}

void village() {
    color plaster = color("#e6dcc3");
    color thatch = color("#b0453a");
    house(vec3(-8, 0, 64), 6, 7, 3.5, 0.3, plaster, thatch);
    house(vec3(8, 0, 61), 6, 8, 3.5, -0.4, plaster, thatch);
    house(vec3(-6, 0, 76), 5, 6, 3, 2.8, plaster, thatch);
    house(vec3(9, 0, 74), 7, 6, 3.5, PI + 0.3, plaster, thatch);
    // Well and a watch post.
    Entity w = spawn("Part", Transform3D { position = vec3(0, 0.45, 68) }, Mesh { shape = "cylinder", size = vec3(1.6, 0.9, 1.6), color = color("#9a9384") }, Collider { size = vec3(1.4, 0.9, 1.4) });
    part(w, "cone", vec3(0, 1.8, 0), vec3(2.2, 0.8, 2.2), thatch);
    part(w, "box", vec3(-0.7, 0.9, 0), vec3(0.1, 1.8, 0.1), color("#5a3f2a"));
    part(w, "box", vec3(0.7, 0.9, 0), vec3(0.1, 1.8, 0.1), color("#5a3f2a"));
}

void vineyard() {
    for (int row = 0; row < 5; row++) {
        float z = -4 + row * 3;
        fence(vec3(26, 0, z), vec3(42, 0, z));
        for (int i = 0; i < 8; i++) {
            Entity v = spawn("Part", Transform3D { position = vec3(27 + i * 2, 0.9, z) }, Mesh { shape = "ico", size = vec3(1.3, 1.1, 0.8), color = color("#4f8f3a") });
            if (random() < 0.7) part(v, "ico", vec3(random(-0.3, 0.3), -0.2, -0.4), vec3(0.3, 0.4, 0.3), color("#6a2f8a"));
        }
    }
    house(vec3(44, 0, 14), 6, 6, 3.2, -PI / 2, color("#e6dcc3"), color("#8a5a2a"));
}

void mine() {
    color rockC = color("#7d7a73");
    // A cliff with a timbered mouth facing the valley.
    for (int i = 0; i < 9; i++) rock(vec3(18 + i * 3, 0, -60 + random(-2, 2)), random(4, 7), rockC);
    spawn("Part", Transform3D { position = vec3(30, 1.6, -56.6) }, Mesh { shape = "box", size = vec3(3.6, 3.2, 0.2), color = color("#120d0a") });
    spawn("Part", Transform3D { position = vec3(28.1, 1.7, -56.3) }, Mesh { shape = "box", size = vec3(0.35, 3.4, 0.35), color = color("#6b4a2a") });
    spawn("Part", Transform3D { position = vec3(31.9, 1.7, -56.3) }, Mesh { shape = "box", size = vec3(0.35, 3.4, 0.35), color = color("#6b4a2a") });
    spawn("Part", Transform3D { position = vec3(30, 3.4, -56.3) }, Mesh { shape = "box", size = vec3(4.4, 0.4, 0.4), color = color("#6b4a2a") });
    // Mine cart track and spoil heaps.
    road(vec3(30, 0, -56), vec3(30, 0, -44));
    for (int i = 0; i < 5; i++) rock(vec3(24 + random(-3, 3) * 2, 0, -46 + random(-4, 4)), random(0.8, 1.6), color("#8a7a62"));
    Entity cart = spawn("Part", Transform3D { position = vec3(31, 0.6, -47) }, Mesh { shape = "box", size = vec3(1.2, 0.8, 1.8), color = color("#6b4a2a") }, Collider { size = vec3(1.2, 1.2, 1.8) });
    part(cart, "ico", vec3(0, 0.45, 0), vec3(1, 0.5, 1.5), color("#5a5a60"));
}

void mountains() {
    for (int i = 0; i < 46; i++) {
        float a = PI * 2 * i / 46;
        // A gap to the south lets the road leave the valley.
        if (abs(a - PI / 2) < 0.12) continue;
        float r = VALLEY + random(0, 10);
        float s = random(16, 26);
        Entity m = spawn("Part", Transform3D { position = vec3(cos(a) * r, s * 0.25, sin(a) * r), scale = vec3(s, s * random(0.8, 1.3), s), rotation = euler(0, random(0, PI), 0) },
            Mesh { shape = "cone", size = vec3(1.4, 1.4, 1.4), color = color("#6f7d6a"), roughness = 1 });
        part(m, "cone", vec3(0, 0.5, 0), vec3(0.42, 0.4, 0.42), color("#e8ecf2"));
    }
}

// Camps spawn their prefab around themselves; models are added per kind.
void dress(Entity e, Mob m) {
    if (m.kind == "wolf") wolf(e, random() < 0.5 ? color("#8a8580") : color("#6f6660"));
    else kobold(e, m.kind == "foreman" ? color("#7a3b2e") : color("#a0703f"), m.kind == "foreman");
}

system Grow(Grown& g) {
    if (g.done) return;
    g.done = true;
    abbey();
    village();
    vineyard();
    mine();
    mountains();
    road(vec3(0, 0, 9), vec3(0, 0, 70));
    road(vec3(2, 0, 22), vec3(25, 0, 6));
    road(vec3(-2, 0, 14), vec3(-24, 0, -2));
    road(vec3(3, 0, 12), vec3(29, 0, -42));
    for (int i = 0; i < 140; i++) {
        vec3 p = anywhere(VALLEY - 6);
        if (!open(p)) continue;
        if (random() < 0.35) pine(p, random(0.9, 1.6));
        else oak(p, random(0.8, 1.4));
    }
    for (int i = 0; i < 40; i++) {
        vec3 p = anywhere(VALLEY - 8);
        if (open(p)) rock(p, random(0.5, 1.3), color("#8d8a80"));
    }
    for (int i = 0; i < 60; i++) {
        vec3 p = anywhere(VALLEY - 8);
        spawn("Part", Transform3D { position = p + vec3(0, 0.12, 0) }, Mesh { shape = "ico", size = vec3(0.18, 0.12, 0.18), color = random() < 0.5 ? color("#ffe066") : color("#f2f2ff") });
    }
    for (Entity c, Camp camp, Transform3D t : query)
        for (int i = 0; i < camp.count; i++) {
            float a = PI * 2 * i / camp.count + random(-0.4, 0.4);
            float r = camp.count == 1 ? 0 : random(1.5, camp.radius);
            vec3 p = t.position + vec3(cos(a) * r, 0, sin(a) * r);
            Entity e = camp.prefab == "Wolf" ? spawn("Wolf", Transform3D { position = p })
                : camp.prefab == "Digger" ? spawn("Digger", Transform3D { position = p })
                : camp.prefab == "Foreman" ? spawn("Foreman", Transform3D { position = p })
                : spawn("Grapes", Transform3D { position = p });
            if (has<Mob>(e)) {
                get<Mob>(e).home = p;
                get<Mob>(e).goal = p;
                get<Mob>(e).heading = random(0, PI * 2);
                dress(e, get<Mob>(e));
            }
            if (has<Pickup>(e)) {
                get<Pickup>(e).home = p;
                part(e, "ico", vec3(-0.15, 0.32, 0), vec3(0.3, 0.3, 0.3), color("#6a2f8a"));
                part(e, "ico", vec3(0.15, 0.3, 0.1), vec3(0.28, 0.28, 0.28), color("#7a3f9a"));
                part(e, "ico", vec3(0, 0.38, -0.12), vec3(0.28, 0.28, 0.28), color("#5a2a7a"));
            }
        }
    for (Entity e, Look l : query) humanoid(e, l);
    for (Entity e, Npc n, Transform3D t : query) spawn("Marker", Transform3D { position = t.position + vec3(0, 1.75, 0) }, Marker { npc = n.id });
}
