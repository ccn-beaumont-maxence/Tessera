// Grows the forest once, from the world's seed: trees, glowing mushrooms, crystals, fireflies, wisps.
resource Forest { bool grown; int trees = 120; int mushrooms = 40; int crystals = 14; int fireflies = 18; int grass = 220; int rocks = 30; float radius = 48; float clearing = 9; }
resource Quest { int found; int total = 12; float time; bool won; float best; }
component Orb { float phase; float baseY = 1.3; bool taken; }

// Uniform point on the ring between two radii.
vec3 scatter(float inner, float outer) {
    float a = random(0, PI * 2);
    float r = sqrt(random(inner * inner, outer * outer));
    return vec3(cos(a) * r, 0, sin(a) * r);
}

color leafColor() {
    int k = randomInt(0, 4);
    return k == 0 ? color("#2a6f6b") : k == 1 ? color("#3d4f8f") : k == 2 ? color("#6b3f8f") : k == 3 ? color("#1f5e4a") : color("#8f3f6f");
}

void tree(vec3 p, float s) {
    Entity t = spawn("Trunk",
        Transform3D { position = p + vec3(0, 2 * s, 0), scale = vec3(s, s, s), rotation = euler(0, random(0, PI * 2), 0) },
        Collider { shape = "box", size = vec3(0.5 * s, 4 * s, 0.5 * s) });
    color c = leafColor();
    if (random() < 0.4) {
        for (int i = 0; i < 3; i++)
            spawn("Pine", Transform3D { position = vec3(0, 1.2 + i * 1.1, 0), scale = vec3(1 - i * 0.25, 1, 1 - i * 0.25) }, Mesh { color = c }, Parent { entity = t });
        return;
    }
    spawn("Leaves", Transform3D { position = vec3(0, 2.3, 0) }, Mesh { color = c }, Parent { entity = t });
    spawn("Leaves", Transform3D { position = vec3(0.8, 1.5, 0.3), scale = vec3(0.6, 0.6, 0.6) }, Mesh { color = c }, Parent { entity = t });
    spawn("Leaves", Transform3D { position = vec3(-0.6, 1.7, -0.5), scale = vec3(0.7, 0.7, 0.7) }, Mesh { color = c }, Parent { entity = t });
}

void mushrooms(vec3 p) {
    int n = randomInt(2, 5);
    for (int i = 0; i < n; i++) {
        float s = random(0.6, 1.8);
        vec3 q = p + vec3(random(-0.8, 0.8), 0, random(-0.8, 0.8));
        Entity m = spawn("Stem", Transform3D { position = q + vec3(0, 0.2 * s, 0), scale = vec3(s, s, s) });
        spawn("Cap", Transform3D { position = vec3(0, 0.22, 0) }, Mesh { color = random() < 0.5 ? color("#ff5fd2") : color("#5fd7ff") }, Parent { entity = m });
    }
    if (random() < 0.35) spawn("Glow", Transform3D { position = p + vec3(0, 0.6, 0) });
}

system Grow(Forest& f, Quest& q) {
    if (f.grown) return;
    f.grown = true;
    q.best = load("forest.best", 0.0);
    for (int i = 0; i < f.trees; i++) tree(scatter(f.clearing, f.radius), random(0.7, 1.7));
    for (int i = 0; i < f.mushrooms; i++) mushrooms(scatter(4, f.radius));
    for (int i = 0; i < f.crystals; i++)
        spawn("Crystal", Transform3D { position = scatter(6, f.radius) + vec3(0, 0.4, 0), rotation = euler(random(-0.4, 0.4), random(0, PI), random(-0.4, 0.4)), scale = vec3(1, random(0.6, 1.6), 1) });
    for (int i = 0; i < f.grass; i++)
        spawn("Grass", Transform3D { position = scatter(3, f.radius) + vec3(0, 0.2, 0), rotation = euler(random(-0.3, 0.3), 0, random(-0.3, 0.3)), scale = vec3(1, random(0.5, 1.5), 1) });
    for (int i = 0; i < f.rocks; i++)
        spawn("Rock", Transform3D { position = scatter(6, f.radius), rotation = euler(0, random(0, PI), 0), scale = vec3(random(0.5, 1.8), random(0.5, 1.5), random(0.5, 1.8)) });
    for (int i = 0; i < f.fireflies; i++) spawn("Fireflies", Transform3D { position = scatter(0, f.radius) + vec3(0, 1.5, 0) });
    for (int i = 0; i < q.total; i++) {
        float a = PI * 2 * i / q.total + random(-0.2, 0.2);
        float r = random(12, f.radius - 6);
        Entity o = spawn("Orb", Transform3D { position = vec3(cos(a) * r, 1.3, sin(a) * r) }, Orb { phase = random(0, PI * 2) });
        spawn("OrbLight", Transform3D {}, Parent { entity = o });
    }
}
